---
import "../styles/global.css";
import resumeUrl from "../assets/docs/RafehCV_NY_New.pdf?url";
import keeperImage from "../assets/img/portfolio/keeper.png";
import gotlrImage from "../assets/img/portfolio/gotlr.png";
import ebharImage from "../assets/img/portfolio/ebhar.png";
import blockrockImage from "../assets/img/portfolio/block.png";
import contextDeskPlatform from "../assets/img/contextdesk/platform-overview.png";
import contextDeskDashboard from "../assets/img/contextdesk/tenant-dashboard.png";
import contextDeskDocuments from "../assets/img/contextdesk/document-operations.png";
import contextDeskCitations from "../assets/img/contextdesk/cited-answer.png";

const projects = [
  {
    name: "Keeper",
    type: "Web3 platform",
    description:
      "A multi-chain product experience connecting wallets and decentralized protocols across Solana, Bitcoin, and EVM networks.",
    stack: ["Next.js", "TypeScript", "Wagmi", "WalletConnect"],
    image: keeperImage.src,
    href: "https://keeperfi.io/",
  },
  {
    name: "Gotlr",
    type: "Real-time mobile marketplace",
    description:
      "A React Native marketplace with location-aware discovery, live chat, payments, and transaction workflows.",
    stack: ["React Native", "Socket.io", "MangoPay", "Maps"],
    image: gotlrImage.src,
    href: "https://gotlr.com/",
  },
  {
    name: "Ebhar",
    type: "Mobile product",
    description:
      "A production mobile experience built around clear discovery, responsive interaction, and dependable cross-platform delivery.",
    stack: ["React Native", "Mobile UX", "API integration"],
    image: ebharImage.src,
    href: "https://ebhar.com/",
  },
  {
    name: "Blockrock",
    type: "Web3 application",
    description:
      "A wallet-connected web application designed to make complex blockchain interactions feel direct and understandable.",
    stack: ["Next.js", "Tailwind CSS", "Wagmi", "Web3"],
    image: blockrockImage.src,
    href: "https://blockrock.app/",
  },
];

const experience = [
  {
    period: "2023 — 2024",
    role: "Software Engineer",
    company: "Aleh Tech FZCO",
    summary:
      "Built multi-chain token deployment, staking, and bridging products, translating complex DeFi workflows into focused web experiences.",
  },
  {
    period: "2021 — 2023",
    role: "Software Engineer",
    company: "Stackup Solutions",
    summary:
      "Delivered SaaS and mobile products with maps, live tracking, payments, localization, and real-time communication.",
  },
  {
    period: "2020 — 2021",
    role: "Associate Software Engineer",
    company: "Hybrid Squares",
    summary:
      "Helped build a wholesale marketplace serving more than 100 vendors and supporting over 1,000 weekly transactions.",
  },
];

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Abdul Rafeh",
  url: "https://abdul-rafeh.github.io",
  email: "mailto:abdulrafeh@live.co.uk",
  jobTitle: "Software Engineer",
  sameAs: ["https://github.com/abdul-rafeh"],
  alumniOf: [
    { "@type": "CollegeOrUniversity", name: "Mercy University" },
    { "@type": "CollegeOrUniversity", name: "COMSATS University Islamabad" },
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#101411" />
    <meta
      name="description"
      content="Abdul Rafeh is a software engineer and computer science graduate student building dependable AI, web, and mobile products."
    />
    <meta property="og:title" content="Abdul Rafeh — Software Engineer" />
    <meta
      property="og:description"
      content="Selected work across AI systems, full-stack web products, mobile applications, and Web3."
    />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://abdul-rafeh.github.io" />
    <meta property="og:image" content="https://abdul-rafeh.github.io/og.png" />
    <meta property="og:image:width" content="1728" />
    <meta property="og:image:height" content="909" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content="https://abdul-rafeh.github.io/og.png" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="canonical" href="https://abdul-rafeh.github.io" />
    <title>Abdul Rafeh — Software Engineer</title>
    <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <header class="site-header">
      <a class="wordmark" href="#top" aria-label="Abdul Rafeh, home">
        AR<span>.</span>
      </a>
      <nav aria-label="Primary navigation">
        <a href="#work">Work</a>
        <a href="#experience">Experience</a>
        <a href="#about">About</a>
      </nav>
      <a class="header-cta" href="mailto:abdulrafeh@live.co.uk">Let’s talk <span>↗</span></a>
    </header>

    <main id="main">
      <section class="hero section" id="top">
        <div class="hero-kicker reveal">Software engineer · New York</div>
        <h1 class="reveal">
          I build dependable products where <em>frontend craft</em> meets systems thinking.
        </h1>
        <div class="hero-bottom reveal">
          <p>
            I’m Abdul, a software engineer and MS in Computer Science candidate focused on AI systems,
            full-stack products, and mobile experiences that make complicated technology feel simple.
          </p>
          <div class="hero-actions">
            <a class="button button-primary" href="#work">Explore my work <span>↓</span></a>
            <a class="button button-secondary" href={resumeUrl} download>Résumé <span>↗</span></a>
          </div>
        </div>

        <div class="signal-strip reveal" aria-label="Portfolio highlights">
          <div><strong>6+</strong><span>Years building products</span></div>
          <div><strong>50+</strong><span>Projects delivered</span></div>
          <div><strong>2026</strong><span>MSCS graduation</span></div>
          <div><strong>NYC</strong><span>Based in New York</span></div>
        </div>
      </section>

      <section class="section work" id="work">
        <div class="section-heading reveal">
          <p class="eyebrow">01 / Selected work</p>
          <h2>Products with depth,<br />not just polish.</h2>
        </div>

        <article class="flagship reveal">
          <div class="flagship-copy">
            <div class="project-meta"><span>Flagship project</span><span>2026</span></div>
            <h3>ContextDesk</h3>
            <p class="project-lede">
              A production-grade, multi-tenant AI knowledge support platform for internal company teams.
              Organizations can manage private knowledge sources, process documents into searchable chunks,
              retrieve tenant-scoped evidence, and generate grounded answers with citations.
            </p>
            <ul class="project-points">
              <li>Backend-enforced organization scope across documents, searches, conversations, and answers</li>
              <li>Durable document processing through extraction, deterministic chunking, and embedding readiness</li>
              <li>Grounded generation with validated citations and persistent conversation history</li>
            </ul>
            <div class="tags" aria-label="ContextDesk technology stack">
              <span>Next.js</span><span>TypeScript</span><span>FastAPI</span><span>Supabase</span><span>pgvector</span><span>SQLAlchemy</span>
            </div>
          </div>
          <div class="system-map" aria-label="ContextDesk system architecture">
            <div class="map-top"><span>ContextDesk</span><span class="status">System ready</span></div>
            <div class="map-flow">
              <div><small>01</small><strong>Upload</strong><span>Private storage</span></div>
              <i>→</i>
              <div><small>02</small><strong>Process</strong><span>Durable jobs</span></div>
              <i>→</i>
              <div><small>03</small><strong>Retrieve</strong><span>Tenant-safe</span></div>
            </div>
            <div class="map-answer">
              <span class="answer-dot"></span>
              <p><small>Grounded answer</small>Every claim maps back to authorized source evidence.</p>
              <span class="citation">[01]</span>
            </div>
            <div class="map-stack"><span>AUTH</span><span>JOBS</span><span>VECTOR</span><span>RAG</span></div>
          </div>
        </article>

        <div class="contextdesk-gallery reveal" aria-labelledby="contextdesk-gallery-title">
          <div class="gallery-intro">
            <p class="gallery-kicker" id="contextdesk-gallery-title">Selected product screens</p>
            <p>
              Tenant administration, document processing, retrieval, and cited answers in one workflow.
            </p>
          </div>

          <div class="gallery-strip">
            <figure class="gallery-item">
              <a href={contextDeskPlatform.src} target="_blank" rel="noreferrer">
                <img
                  src={contextDeskPlatform.src}
                  alt="ContextDesk platform overview showing retrieved sources, a grounded answer, and the RAG pipeline"
                  loading="lazy"
                />
              </a>
              <figcaption>
                <span><strong>01</strong> Platform overview</span>
                <span>↗</span>
              </figcaption>
            </figure>

            <figure class="gallery-item">
              <a href={contextDeskDashboard.src} target="_blank" rel="noreferrer">
                <img
                  src={contextDeskDashboard.src}
                  alt="ContextDesk tenant dashboard with organization workspaces and security controls"
                  loading="lazy"
                />
              </a>
              <figcaption>
                <span><strong>02</strong> Tenant dashboard</span>
                <span>↗</span>
              </figcaption>
            </figure>

            <figure class="gallery-item">
              <a href={contextDeskDocuments.src} target="_blank" rel="noreferrer">
                <img
                  src={contextDeskDocuments.src}
                  alt="ContextDesk document operations dashboard showing retrieval-ready documents"
                  loading="lazy"
                />
              </a>
              <figcaption>
                <span><strong>03</strong> Document operations</span>
                <span>↗</span>
              </figcaption>
            </figure>

            <figure class="gallery-item">
              <a href={contextDeskCitations.src} target="_blank" rel="noreferrer">
                <img
                  class="gallery-citation-image"
                  src={contextDeskCitations.src}
                  alt="ContextDesk grounded conversation showing an answer with its validated source citation"
                  loading="lazy"
                />
              </a>
              <figcaption>
                <span><strong>04</strong> Grounded conversation</span>
                <span>↗</span>
              </figcaption>
            </figure>
          </div>
        </div>

        <a class="mediassist-feature reveal" href="/projects/mediassist/">
          <div class="mediassist-copy">
            <div class="project-meta"><span>Featured clinical AI project</span><span>2026</span></div>
            <div>
              <p class="mediassist-label">Fail-closed architecture</p>
              <h3>MediAssist</h3>
              <p>
                A clinical AI system that routes patient queries to isolated, authoritative medical
                databases—and rejects ambiguity instead of allowing an LLM to guess.
              </p>
              <div class="tags" aria-label="MediAssist technology stack">
                <span>Bio-ClinicalBERT</span><span>Hybrid RAG</span><span>FastAPI</span><span>React Native</span>
              </div>
            </div>
            <span class="mediassist-link">Read the case study <b>↗</b></span>
          </div>
          <div class="mediassist-flow" aria-label="MediAssist fail-closed query flow">
            <div class="flow-title"><span>Clinical query route</span><span>02</span></div>
            <div class="flow-node flow-query"><small>INPUT</small><strong>Patient query</strong></div>
            <span class="flow-line"></span>
            <div class="flow-node flow-router"><small>ROUTER</small><strong>7-class NLU</strong><em>0.82 Macro F1</em></div>
            <div class="flow-branches">
              <div><span>High confidence</span><strong>Authorized index →</strong></div>
              <div class="flow-reject"><span>Ambiguous</span><strong>Reject safely ×</strong></div>
            </div>
          </div>
        </a>

        <div class="project-grid">
          {projects.map((project, index) => (
            <a class="project-card reveal" href={project.href} target="_blank" rel="noreferrer">
              <div class="project-image">
                <img src={project.image} alt={`${project.name} product interface`} loading="lazy" />
                <span class="project-number">0{index + 3}</span>
              </div>
              <div class="project-card-copy">
                <div><span>{project.type}</span><span>↗</span></div>
                <h3>{project.name}</h3>
                <p>{project.description}</p>
                <div class="tags">{project.stack.map((item) => <span>{item}</span>)}</div>
              </div>
            </a>
          ))}
        </div>
      </section>

      <section class="section experience" id="experience">
        <div class="section-heading reveal">
          <p class="eyebrow">02 / Experience</p>
          <h2>Built in production.<br />Sharpened in practice.</h2>
        </div>
        <div class="timeline">
          {experience.map((item, index) => (
            <article class="timeline-row reveal">
              <span class="timeline-index">0{index + 1}</span>
              <span class="timeline-period">{item.period}</span>
              <div><h3>{item.role}</h3><p class="company">{item.company}</p></div>
              <p>{item.summary}</p>
            </article>
          ))}
        </div>
      </section>

      <section class="section about" id="about">
        <div class="portrait-wrap reveal">
          <img src="/me.jpeg" alt="Abdul Rafeh" loading="lazy" />
          <div class="portrait-label"><span>Based in</span><strong>New York, NY</strong></div>
        </div>
        <div class="about-copy reveal">
          <p class="eyebrow">03 / About</p>
          <h2>Engineer, student, and relentless problem solver.</h2>
          <p>
            My work spans responsive interfaces, real-time mobile systems, payment workflows, Web3,
            and secure AI infrastructure. I care about the parts users see and the boundaries that keep
            the system correct when they don’t.
          </p>
          <div class="education-card">
            <span>Expected December 2026</span>
            <h3>MS in Computer Science</h3>
            <p>Mercy University · Artificial intelligence, data science, and machine learning</p>
          </div>
          <div class="education-card">
            <span>Completed January 2022</span>
            <h3>BS in Computer Science</h3>
            <p>COMSATS University Islamabad</p>
          </div>
        </div>
      </section>

      <section class="contact section reveal" id="contact">
        <p class="eyebrow">04 / Contact</p>
        <h2>Have an interesting<br />problem to solve?</h2>
        <div class="contact-bottom">
          <p>I’m open to software engineering opportunities, ambitious products, and thoughtful collaborations.</p>
          <a href="mailto:abdulrafeh@live.co.uk">abdulrafeh@live.co.uk <span>↗</span></a>
        </div>
      </section>
    </main>

    <footer>
      <span>© {new Date().getFullYear()} Abdul Rafeh</span>
      <div>
        <a href="https://github.com/abdul-rafeh" target="_blank" rel="noreferrer">GitHub ↗</a>
        <a href={resumeUrl} download>Résumé ↗</a>
      </div>
      <a href="#top">Back to top ↑</a>
    </footer>

    <script>
      const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      if (!reducedMotion) {
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add("is-visible");
                observer.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.12 },
        );
        document.querySelectorAll(".reveal").forEach((element) => observer.observe(element));
      } else {
        document.querySelectorAll(".reveal").forEach((element) => element.classList.add("is-visible"));
      }
    </script>
  </body>
</html>
